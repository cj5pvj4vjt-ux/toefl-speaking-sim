{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@database/*": ["src/database/*"],
      "@main/*": ["src/electron/*"]
    }
  },
  "include": [
    "src/electron/**/*.ts",
    "src/shared/**/*.ts",
    "src/database/**/*.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts"
  ]
}
